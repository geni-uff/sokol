# =============================================================================
# SOKOL — copie para .env na raiz do repositório e ajuste antes do compose.
# API e worker usam network_mode: host: Postgres, Redis e LM Studio são
# localhost no host, não host.docker.internal nem o hostname do container.
# =============================================================================

# --- Geral ---
SOKOL_ENV=local

# --- Postgres ---
POSTGRES_DB=sokol
POSTGRES_USER=sokol
POSTGRES_PASSWORD=change_me
# Compose publica o Postgres em 5433 no host. API/worker (host network)
# usam este URL; o serviço sokol-postgres continua na 5432 interna.
SOKOL_POSTGRES_PORT=5433
DATABASE_URL=postgresql://sokol:change_me@localhost:5433/sokol

# --- Redis ---
SOKOL_REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Portas da UI / API / LM Studio ---
SOKOL_API_PORT=8000
SOKOL_WEB_PORT=3000
SOKOL_LMSTUDIO_PORT=1234

# --- LLM (LM Studio no host) ---
# Id do modelo = o que o LM Studio expõe em GET /v1/models.
SOKOL_LMSTUDIO_BASE_URL=http://localhost:1234/v1
SOKOL_DEFAULT_LLM_MODEL=change_me
SOKOL_ACTIVE_LLM_MODEL=${SOKOL_DEFAULT_LLM_MODEL}
SOKOL_ALLOWED_LLM_MODELS=change_me
SOKOL_LLM_CONTEXT_LENGTH=32768
SOKOL_LLM_N_CTX=32768

# --- Embedding ---
# Padrão operacional: mesmo LM Studio do LLM (API em host network).
SOKOL_EMBED_BASE_URL=http://localhost:1234/v1
SOKOL_DEFAULT_EMBED_MODEL=text-embedding-qwen3-embedding-0.6b
SOKOL_ACTIVE_EMBED_MODEL=${SOKOL_DEFAULT_EMBED_MODEL}
SOKOL_ALLOWED_EMBED_MODELS=text-embedding-qwen3-embedding-0.6b
SOKOL_EMBED_PROVIDER=lmstudio
SOKOL_EMBED_DIM=1024
SOKOL_EMBED_CONTEXT_LENGTH=32768
# Se o LM Studio não conseguir carregar o GGUF de embedding (VRAM ocupada
# pelo LLM), o worker cai em sokol-embed (:8001) automaticamente.
# SOKOL_EMBED_FALLBACK_URL=http://localhost:8001/v1
# Alternativa exclusiva: serviço Docker sokol-embed
# SOKOL_EMBED_BASE_URL=http://localhost:8001/v1
# SOKOL_EMBED_PROVIDER=sokol-embed
# SOKOL_DEFAULT_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B

# --- Reranker ---
SOKOL_DEFAULT_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
SOKOL_ACTIVE_RERANK_MODEL=${SOKOL_DEFAULT_RERANK_MODEL}

# --- GPU ---
SOKOL_GPU_MODE=auto
SOKOL_GPU_LMSTUDIO=auto
SOKOL_GPU_AUX=auto
SOKOL_GPU_RERANK=auto
SOKOL_GPU_DOC=auto
SOKOL_GPU_ASR=auto
SOKOL_GPU_VISION=auto
SOKOL_GPU_FACE=auto
SOKOL_GPU_PLATE=auto

# --- Concorrência ---
SOKOL_MAX_LLM_CONCURRENCY=auto
SOKOL_MAX_AUX_CONCURRENCY=auto

# --- Dados (caminhos DENTRO dos containers) ---
SOKOL_DATA_DIR=/data
SOKOL_FINAL_DIR=/data/final
SOKOL_STAGING_DIR=/data/staging
SOKOL_MEDIA_CACHE_DIR=/data/media-cache
SOKOL_BACKUP_DIR=/data/backups
# Staging no tar: auto (se ≤ SOKOL_BACKUP_STAGING_MAX_MB), 1=forçar, 0=nunca
SOKOL_BACKUP_INCLUDE_STAGING=auto
SOKOL_BACKUP_STAGING_MAX_MB=2048
SOKOL_BACKUP_CHECK_INTERVAL=300

# Pasta no HOST com os UFDRs. Relativa a deploy/ ou absoluta.
# Mudar ESTE valor exige `compose up -d` (recria o mount). Copiar arquivos
# para a pasta já montada NÃO exige parar o Docker.
SOKOL_INGEST_DIR=../UFDRsTest
# Alias antigo; o compose usa SOKOL_INGEST_DIR.
SOKOL_HOST_INGEST_DIR=../UFDRsTest
SOKOL_CONTAINER_INGEST_DIR=/ingest/inbox
